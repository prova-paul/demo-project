{
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx jest:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git push origin main:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(pm2 status)",
      "Bash(pm2 logs:*)",
      "Bash(ls:*)",
      "Bash(cat:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push origin production:*)",
      "Bash(git push origin staging:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(pm2 restart:*)",
      "Bash(pm2 stop:*)",
      "Bash(pm2 delete:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(config/secrets/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\""
          }
        ]
      }
    ]
  }
}
